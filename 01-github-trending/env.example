# GitHub Trending AI 每日追踪 - 环境变量
# 复制为 .env 并填入真实值
# n8n 通过 docker-compose env_file 注入这些变量

# === 飞书应用 ===
# 飞书开放平台创建应用后获取: https://open.feishu.cn/app
N8N_01_FEISHU_APP_ID=your_app_id
N8N_01_FEISHU_APP_SECRET=your_app_secret

# 飞书群机器人 Webhook URL
# 群设置 → 群机器人 → 添加自定义机器人 → 复制 Webhook 地址
N8N_01_FEISHU_WEBHOOK=https://open.feishu.cn/open-apis/bot/v2/hook/your_webhook_id

# === 飞书多维表格 ===
# 多维表格 URL 中的 token: https://my.feishu.cn/base/{BITABLE_ID}
N8N_01_FEISHU_BITABLE_ID=your_bitable_token

# 数据表 ID（在多维表格 URL 中看不到，需要通过 API 或页面元素获取）
# 经典项目表: 存放 stars>5000 的老牌 AI 项目
N8N_01_FEISHU_TABLE_CLASSIC=your_classic_table_id
# 新锐项目表: 存放最近7天新建且 stars>100 的新项目
N8N_01_FEISHU_TABLE_TRENDING=your_trending_table_id

# === Ollama 翻译引擎 ===
# 用于将英文项目描述翻译成中文
# 需要部署 Ollama 并拉取模型: ollama pull qwen2.5:3b
N8N_01_OLLAMA_HOST=localhost
N8N_01_OLLAMA_PORT=11434
